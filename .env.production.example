# ==============================================================================
# drive-unix Production Environment Configuration Template (.env.production.example)
# ==============================================================================
# Instructions:
#   1. Copy this file to '.env':
#      cp .env.production.example .env
#   2. Restrict file permissions immediately to prevent unauthorized access:
#      chmod 600 .env
#   3. Replace all placeholder values below with your real production secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Network & Server Core Configuration
# ------------------------------------------------------------------------------
# Host IP binding:
#   - In Docker containers: MUST be 0.0.0.0
#   - When running behind local Nginx reverse proxy: set to 127.0.0.1 for security
DRIVE_UNIX_HOST=0.0.0.0

# Listening Port for Web Management Console & REST API (default: 8000)
DRIVE_UNIX_PORT=8000

# Force unbuffered Python stdout/stderr for real-time Docker & systemd journal logs
PYTHONUNBUFFERED=1

# ------------------------------------------------------------------------------
# 2. Upstash Serverless Redis & End-to-End Encryption (E2EE) Sync
# ------------------------------------------------------------------------------
# Upstash REST API credentials (obtain from https://console.upstash.com/)
UPSTASH_REDIS_REST_URL=https://your-database-id.upstash.io
UPSTASH_REDIS_REST_TOKEN=AxxxxxxxYourUpstashRestTokenHerexxxxxxxx

# Upstash Redis synchronization storage key (use unique keys for different environments)
UPSTASH_SYNC_KEY=drive-unix:sync:default

# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
# [CRITICAL SECURITY WARNING: UPSTASH_SYNC_PASSPHRASE]
# This master passphrase derives the AES-256-GCM encryption key via PBKDF2 (100,000
# iterations). It protects ALL cloud credentials, OAuth tokens, and SharePoint cookies.
#
# RULES:
#   1. MUST be a strong, unpredictable random passphrase (minimum 32+ characters).
#   2. ALL client nodes & daemon instances synchronizing via Upstash MUST use
#      the EXACT SAME passphrase to decrypt the payload.
#   3. IF LOST, ENCRYPTED CREDENTIALS CANNOT BE RECOVERED BY ANYONE, EVER!
# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
UPSTASH_SYNC_PASSPHRASE=ReplaceWithSuperSecureRandomPassphrase_Min32Chars!

# Enable automatic token synchronization with Upstash (true/false)
UPSTASH_AUTO_SYNC_TOKENS=true

# Enable automatic token pushing upon renewal (true/false)
UPSTASH_AUTO_PUSH_TOKENS=true

# Renewal leeway margin in minutes:
# If a token will expire within this threshold, the renewal daemon refreshes it proactively
UPSTASH_RENEW_LEEWAY_MINUTES=60

# ------------------------------------------------------------------------------
# 3. Storage, Paths & NAS User/Group Isolation (PUID / PGID)
# ------------------------------------------------------------------------------
# Persistent configuration directory path
DRIVE_UNIX_CONFIG_DIR=/root/.config/drive-unix

# Host external storage data mount directory mapped into container (/data)
# For Synology NAS: e.g. /volume1/shared_folder
# For QNAP NAS:     e.g. /share/CACHEDEV1_DATA/shared_folder
STORAGE_DATA_DIR=./data

# NAS / Linux User ID and Group ID mappings:
# Prevents permission conflicts when writing to host/NAS storage volumes.
#   - Standard Linux: PUID=1000, PGID=1000
#   - Synology DSM:   PUID=1026 (or admin UID), PGID=100 (users)
#   - QNAP QTS:       PUID=1000, PGID=100
PUID=1000
PGID=1000

# SharePoint Headless Playwright debug screenshot destination (for MFA / Captcha debugging)
SHAREPOINT_SCREENSHOT_DIR=/root/.config/drive-unix/debug
DRIVE_UNIX_DEBUG_DIR=/root/.config/drive-unix/debug

# ------------------------------------------------------------------------------
# 4. Logging & Observability
# ------------------------------------------------------------------------------
# Application log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
DRIVE_UNIX_LOG_LEVEL=INFO

# Disable ANSI color escape codes in logs (0 = enabled/colored, 1 = disabled/plain text)
NO_COLOR=0

# ------------------------------------------------------------------------------
# 5. Concurrency, Performance & Transfer Throttling
# ------------------------------------------------------------------------------
# Number of parallel worker threads for batch file transfer/synchronization (default: 4)
DRIVE_UNIX_MAX_WORKERS=4

# Global bandwidth throttling in Kilobits per second (0 = unlimited)
DRIVE_UNIX_BANDWIDTH_LIMIT_KBPS=0

# Local SQLite directory metadata cache Time-To-Live in seconds (default: 300)
DRIVE_UNIX_CACHE_TTL=300

# Maximum permitted single-file upload size in Megabytes (default: 2048 MB = 2 GB)
DRIVE_UNIX_MAX_UPLOAD_SIZE_MB=2048

# ------------------------------------------------------------------------------
# 6. Third-Party OAuth Protocol Tuning
# ------------------------------------------------------------------------------
# Allow relaxed OAuth token scope matching for Microsoft OneDrive / SharePoint
OAUTHLIB_RELAX_TOKEN_SCOPE=1
